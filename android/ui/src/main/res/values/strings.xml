    <string name="welcome_title">Welcome to Snackshot</string>
    <string name="welcome_body">Your AI recognition and privacy-first nutrition tracker. No registration needed. We do not store your personal health data on external servers. Your first 90 AI pictures are free.</string>
    <string name="welcome_continue">Continue</string>
    <string name="welcome_privacy_details">Privacy details</string>
